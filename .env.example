# ==============================================================
# TELEHEALTH HOSPITAL MANAGEMENT - ENVIRONMENT CONFIGURATION
# ==============================================================

# Database Global Settings (PostgreSQL container)
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_root_password_change_me
POSTGRES_MULTIPLE_DATABASES=identity_db:identity_user:identity_pass,appointment_db:appointment_user:appointment_pass,clinical_db:clinical_user:clinical_pass,billing_db:billing_user:billing_pass,realtime_db:realtime_user:realtime_pass,notification_db:notification_user:notification_pass

# Service Database Credentials
IDENTITY_DB_NAME=identity_db
IDENTITY_DB_USER=identity_user
IDENTITY_DB_PASSWORD=identity_pass

APPOINTMENT_DB_NAME=appointment_db
APPOINTMENT_DB_USER=appointment_user
APPOINTMENT_DB_PASSWORD=appointment_pass

CLINICAL_DB_NAME=clinical_db
CLINICAL_DB_USER=clinical_user
CLINICAL_DB_PASSWORD=clinical_pass

BILLING_DB_NAME=billing_db
BILLING_DB_USER=billing_user
BILLING_DB_PASSWORD=billing_pass

REALTIME_DB_NAME=realtime_db
REALTIME_DB_USER=realtime_user
REALTIME_DB_PASSWORD=realtime_pass

NOTIFICATION_DB_NAME=notification_db
NOTIFICATION_DB_USER=notification_user
NOTIFICATION_DB_PASSWORD=notification_pass

# Redis Configuration
REDIS_HOST=redis
REDIS_PORT=6379

# RabbitMQ Configuration
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# Security & Encryption (AES-256 Key & JWT)
# Minimum 32-character secrets
JWT_SECRET=telehealth_jwt_super_secret_key_minimum_256_bits_length_12345
CLINICAL_ENCRYPTION_KEY=telehealth_clinical_aes_gcm_secret_key_32_bytes!
REALTIME_ENCRYPTION_KEY=telehealth_realtime_aes_gcm_secret_key_32_bytes!
INTERNAL_SERVICE_SECRET=telehealth_internal_microservice_shared_secret_2026

# WebRTC & Coturn STUN/TURN
TURN_HOST=localhost
TURN_PORT=3478
TURN_SECRET=telehealth_turn_shared_secret_2026

# Email / Mailpit Configuration
# Local development default is Mailpit (port 1025, no auth)
# Enable this optional container only when using Mailpit; unset for Resend/external SMTP.
COMPOSE_PROFILES=mailpit
# For production Gmail SMTP:
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=your_email@gmail.com
# SPRING_MAIL_PASSWORD=your_16_digit_app_password
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=true
# SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=true
# MAIL_FROM=your_email@gmail.com
# Optional: only the two dedicated demo patients use this recipient instead of their login email.
DEMO_NOTIFICATION_EMAIL=
SPRING_MAIL_HOST=mailpit
SPRING_MAIL_PORT=1025
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=no-reply@telehealth.local
SPRING_MAIL_PROPERTIES_MAIL_SMTP_AUTH=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_ENABLE=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_STARTTLS_REQUIRED=false
SPRING_MAIL_PROPERTIES_MAIL_SMTP_SSL_ENABLE=false

# Base URLs
GATEWAY_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
